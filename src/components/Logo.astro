---
/**
 * Brand mark: the four-quadrant icon (sun / water / layered B&K motif / basin)
 * plus the "Bath & Kitchen Studio" wordmark. `tone` flips it for dark sections.
 */
export interface Props {
  tone?: 'dark' | 'light';
  compact?: boolean;
  class?: string;
}
const { tone = 'dark', compact = false, class: cls = '' } = Astro.props;
---

<span class={`logo ${cls}`} data-tone={tone} aria-hidden="false">
  <svg
    class="logo__mark"
    viewBox="0 0 100 100"
    role="img"
    aria-label="Bath & Kitchen Studio"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
  >
    <rect x="3" y="3" width="94" height="94" />
    <line x1="50" y1="3" x2="50" y2="97" />
    <line x1="3" y1="50" x2="97" y2="50" />
    <!-- top-left: sun -->
    <circle cx="26.5" cy="26.5" r="7" />
    <g stroke-width="2">
      <line x1="26.5" y1="11" x2="26.5" y2="15" />
      <line x1="26.5" y1="38" x2="26.5" y2="42" />
      <line x1="11" y1="26.5" x2="15" y2="26.5" />
      <line x1="38" y1="26.5" x2="42" y2="26.5" />
      <line x1="16" y1="16" x2="18.5" y2="18.5" />
      <line x1="34.5" y1="34.5" x2="37" y2="37" />
      <line x1="37" y1="16" x2="34.5" y2="18.5" />
      <line x1="18.5" y1="34.5" x2="16" y2="37" />
    </g>
    <!-- top-right: water -->
    <g stroke-width="2.2">
      <path d="M58 22 q4 -4 8 0 t8 0 t8 0" />
      <path d="M58 30 q4 -4 8 0 t8 0 t8 0" />
    </g>
    <!-- bottom-left: layered motif -->
    <g stroke-width="2">
      <polyline points="14,86 14,64 36,64" />
      <polyline points="19,86 19,69 36,69" />
      <polyline points="24,86 24,74 36,74" />
      <polyline points="29,86 29,79 36,79" />
    </g>
    <!-- bottom-right: basin -->
    <g stroke-width="2.2">
      <path d="M60 70 h28 a14 14 0 0 1 -28 0 z" />
      <line x1="74" y1="62" x2="74" y2="70" />
      <circle cx="74" cy="60" r="2.4" />
    </g>
  </svg>
  {!compact && (
    <span class="logo__word">
      <span class="logo__bk">Bath &amp;<br />Kitchen</span>
      <span class="logo__studio">Studio</span>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    line-height: 1;
    color: var(--black);
  }
  .logo[data-tone='light'] {
    color: var(--white);
  }
  .logo__mark {
    width: 46px;
    height: 46px;
    flex: none;
  }
  .logo__word {
    display: inline-flex;
    flex-direction: column;
    color: var(--black);
  }
  .logo[data-tone='light'] .logo__word {
    color: var(--white);
  }
  .logo__bk {
    font-weight: 700;
    text-transform: none;
    font-size: 1.18rem;
    line-height: 0.98;
    letter-spacing: -0.01em;
  }
  .logo__studio {
    font-weight: 400;
    font-size: 1.18rem;
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--grey-500);
  }
</style>
