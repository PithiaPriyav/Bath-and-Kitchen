---
import Logo from './Logo.astro';
import { nav, offer, offerIsVisible, offerHasStarted, offerWindow } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
const showPromo = offerIsVisible();
const started = offerHasStarted();
---

{showPromo && (
  <div class="promo">
    <a class="promo__inner wrap" href="/offers">
      <span class="promo__tag">{started ? offer.kicker : 'Coming Soon'}</span>
      <span class="promo__text">
        <strong>{offer.name}</strong> — {offer.headline}. {offerWindow()}, while stocks last.
      </span>
      <span class="promo__cta">{started ? 'Shop the event' : 'See the deals'} →</span>
    </a>
  </div>
)}

<header class="site-header" data-promo={showPromo}>
  <div class="wrap site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Bath & Kitchen Studio — home">
      <Logo />
    </a>

    <nav class="nav" aria-label="Primary">
      {nav.map((item) => (
        <a
          class="nav__link"
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a class="contact-btn" href="/contact">Contact</a>
      <button
        class="hamburger"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="hamburger__bars" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="mobile-menu__nav" aria-label="Mobile">
      {nav.map((item) => (
        <a
          class="mobile-menu__link"
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a class="mobile-menu__link mobile-menu__link--cta" href="/contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  /* ---- Promo bar (OFFER-ONLY accent) ---- */
  .promo {
    background: var(--red);
    color: var(--white);
  }
  .promo__inner {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-block: 0.6rem;
    font-size: 0.82rem;
  }
  .promo__tag {
    flex: none;
    background: var(--yellow);
    color: var(--black);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.68rem;
    padding: 0.25rem 0.55rem;
  }
  .promo__text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .promo__cta {
    flex: none;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.72rem;
  }

  /* ---- Sticky header ---- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(160%) blur(8px);
    border-bottom: 1px solid var(--grey-200);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 76px;
  }
  .site-header__brand {
    margin-right: auto;
  }

  .nav {
    display: flex;
    gap: 1.8rem;
  }
  .nav__link {
    font-weight: 600;
    font-size: 0.86rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--grey-700);
    padding: 0.4rem 0;
    position: relative;
    transition: color 0.2s var(--ease);
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 2px;
    background: var(--black);
    transition: width 0.25s var(--ease);
  }
  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--black);
  }
  .nav__link:hover::after,
  .nav__link[aria-current='page']::after {
    width: 100%;
  }

  .site-header__actions {
    display: flex;
    align-items: stretch;
    border: 1.5px solid var(--black);
  }
  .contact-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.2rem;
    font-weight: 600;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .contact-btn:hover {
    background: var(--black);
    color: var(--white);
  }
  .hamburger {
    display: none;
    width: 46px;
    border: none;
    border-left: 1.5px solid var(--black);
    background: transparent;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }
  .hamburger__bars {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    width: 20px;
  }
  .hamburger__bars span {
    display: block;
    height: 2px;
    background: var(--black);
    transition: transform 0.25s var(--ease), opacity 0.2s var(--ease);
  }
  .hamburger[aria-expanded='true'] .hamburger__bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .hamburger[aria-expanded='true'] .hamburger__bars span:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded='true'] .hamburger__bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ---- Mobile menu ---- */
  .mobile-menu {
    border-bottom: 1px solid var(--grey-200);
    background: var(--white);
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    padding: 0.5rem var(--gutter) 1.25rem;
  }
  .mobile-menu__link {
    padding: 0.95rem 0;
    font-weight: 600;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--grey-100);
  }
  .mobile-menu__link--cta {
    margin-top: 1rem;
    border: 1.5px solid var(--black);
    text-align: center;
    border-bottom: 1.5px solid var(--black);
  }

  @media (max-width: 880px) {
    .nav {
      display: none;
    }
    .contact-btn {
      display: none;
    }
    .hamburger {
      display: inline-flex;
    }
    .site-header__actions {
      border: none;
    }
    .hamburger {
      border: 1.5px solid var(--black);
    }
  }
  @media (min-width: 881px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.hamburger');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
      menu.hidden = open;
    });
    // Close on resize up to desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth > 880) {
        btn.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
      }
    });
  }
</script>
