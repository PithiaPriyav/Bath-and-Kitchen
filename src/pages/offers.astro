---
import Base from '../layouts/Base.astro';
import {
  site,
  offer,
  offerIsVisible,
  offerHasStarted,
  offerWindow,
  offerStatusLabel,
  fmt,
} from '../data/site';

const live = offerIsVisible();
const started = offerHasStarted();
const statusLabel = offerStatusLabel();
const saving = (was: number, now: number) => Math.round(((was - now) / was) * 100);
---

<Base
  title={live ? offer.name : 'Offers'}
  description={
    live
      ? `${offer.name}: ${offer.headline}. ${offerWindow()}, while stocks last. Premium bath, kitchen and tile lines at once-a-year pricing.`
      : 'Current promotions at Bath & Kitchen Studio, Nairobi. Visit the showroom for the latest pricing on tiles, kitchens and bathrooms.'
  }
  path="/offers"
>
  {live ? (
    <>
      <!-- ====== Offer hero (OFFER-ONLY accent) ====== -->
      <section class="offer-hero">
        <div class="wrap">
          <span class="offer-hero__tag">{statusLabel || offer.kicker} · {offerWindow()}</span>
          <h1 class="h-xl offer-hero__h">
            {offer.name.toUpperCase()}
          </h1>
          <p class="offer-hero__headline">{offer.headline}</p>
          <p class="offer-hero__sub">{offer.sub}</p>
          {!started && (
            <p class="offer-hero__preview">
              Previewing now — doors open {offerWindow().split('–')[0].trim()}. Enquire early to reserve while stocks last.
            </p>
          )}
        </div>
      </section>

      <!-- ====== Deal grid ====== -->
      <section class="sec sec--white">
        <div class="wrap">
          <ul class="deals">
            {offer.deals.map((d) => (
              <li class="deal reveal">
                <div class="deal__top">
                  <span class="deal__cat">{d.category}</span>
                  <span class="deal__save">-{saving(d.was, d.now)}%</span>
                </div>
                <h2 class="deal__name">{d.name}</h2>
                {d.brand && <p class="deal__brand">{d.brand}</p>}
                {d.note && <p class="deal__note">{d.note}</p>}
                <div class="deal__prices">
                  <span class="deal__was">{fmt(d.was)}</span>
                  <span class="deal__now">{fmt(d.now)}</span>
                  {d.unit && <span class="deal__unit">{d.unit}</span>}
                </div>
                <a class="btn btn--offer deal__cta" href="/contact">Enquire</a>
              </li>
            ))}
          </ul>

          <p class="offer-terms">{offer.terms}</p>
        </div>
      </section>

      <!-- ====== CTA ====== -->
      <section class="sec sec--black on-black">
        <div class="wrap offer-cta">
          <p class="kicker">Don't miss it</p>
          <h2 class="h-lg">
            LUXURY AT <span class="dim">GIVEAWAY</span> PRICES.
          </h2>
          <p class="offer-cta__sub">Visit the showroom before {offerWindow().split('–')[1]} — while stocks last.</p>
          <div class="offer-cta__actions">
            <a class="btn" href="/contact">Plan your visit</a>
            <a class="btn btn--ghost" href={`tel:${site.phones[0].replace(/\s+/g, '')}`}>{site.phones[0]}</a>
          </div>
        </div>
      </section>
    </>
  ) : (
    <!-- ====== Empty state ====== -->
    <section class="sec sec--white empty">
      <div class="wrap empty__inner">
        <p class="kicker">Offers</p>
        <h1 class="h-xl empty__h">
          NO ACTIVE OFFERS <span class="dim">RIGHT NOW.</span>
        </h1>
        <p class="empty__p">
          Our next event isn't live yet — but our showroom prices are always sharp.
          Visit us or get in touch for current pricing on tiles, kitchens, bathrooms and wardrobes.
        </p>
        <div class="empty__actions">
          <a class="btn" href="/contact">Visit the showroom</a>
          <a class="btn btn--ghost" href="/products">Browse products</a>
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  /* ---- Offer hero (OFFER-ONLY accent) ---- */
  .offer-hero {
    background: var(--red);
    color: var(--white);
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .offer-hero__tag {
    display: inline-block;
    background: var(--yellow);
    color: var(--black);
    font-weight: 700;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.4rem 0.7rem;
    margin-bottom: 1.4rem;
  }
  .offer-hero__h {
    max-width: 18ch;
  }
  .offer-hero__headline {
    margin-top: 1.2rem;
    font-size: clamp(1.3rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--yellow);
  }
  .offer-hero__sub {
    margin-top: 1rem;
    max-width: 56ch;
    color: rgba(255, 255, 255, 0.9);
  }
  .offer-hero__preview {
    margin-top: 1.4rem;
    display: inline-block;
    background: var(--yellow);
    color: var(--black);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.7rem 1rem;
    max-width: 60ch;
  }

  /* ---- Deals ---- */
  .deals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .deal {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid var(--grey-200);
    border-top: 3px solid var(--red);
  }
  .deal__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .deal__cat {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--grey-500);
  }
  .deal__save {
    background: var(--red);
    color: var(--white);
    font-weight: 700;
    font-size: 0.78rem;
    padding: 0.2rem 0.55rem;
  }
  .deal__name {
    font-size: 1.05rem;
    line-height: 1.15;
  }
  .deal__brand {
    margin-top: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--grey-700);
  }
  .deal__note {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--grey-500);
    flex: 1;
  }
  .deal__prices {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.2rem;
  }
  .deal__was {
    color: var(--grey-400);
    text-decoration: line-through;
    font-size: 0.9rem;
  }
  .deal__now {
    font-weight: 800;
    font-size: 1.4rem;
    color: var(--red);
  }
  .deal__unit {
    font-size: 0.8rem;
    color: var(--grey-500);
  }
  .deal__cta {
    margin-top: 1.4rem;
  }

  .offer-terms {
    margin-top: 2.5rem;
    font-size: 0.82rem;
    color: var(--grey-500);
    max-width: 70ch;
  }

  /* ---- Offer CTA ---- */
  .offer-cta__sub {
    margin: 1.2rem 0 2rem;
    color: var(--grey-300);
    font-size: 1.1rem;
  }
  .offer-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  /* ---- Empty state ---- */
  .empty__inner {
    max-width: 60ch;
  }
  .empty__h {
    margin-top: 1rem;
  }
  .empty__p {
    margin-top: 1.4rem;
    font-size: 1.1rem;
    color: var(--grey-700);
  }
  .empty__actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  @media (max-width: 920px) {
    .deals {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .deals {
      grid-template-columns: 1fr;
    }
  }
</style>
