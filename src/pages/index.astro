---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import {
  site,
  categories,
  clientele,
  service,
  offer,
  offerIsVisible,
  offerHasStarted,
  offerWindow,
  offerStatusLabel,
} from '../data/site';

// Dummy imagery (swap for real photography later — same <Image /> pipeline).
import heroA from '../assets/home/hero-a.jpg';
import heroB from '../assets/home/hero-b.jpg';
import service3d from '../assets/home/service-3d.jpg';
import feat1 from '../assets/home/feat-1.jpg';
import feat2 from '../assets/home/feat-2.jpg';
import feat3 from '../assets/home/feat-3.jpg';
import feat4 from '../assets/home/feat-4.jpg';
import catTiles from '../assets/home/cat-tiles.jpg';
import catKitchens from '../assets/home/cat-kitchens.jpg';
import catBathrooms from '../assets/home/cat-bathrooms.jpg';
import catWardrobes from '../assets/home/cat-wardrobes.jpg';
import av1 from '../assets/home/av-1.jpg';
import av2 from '../assets/home/av-2.jpg';
import av3 from '../assets/home/av-3.jpg';
import av4 from '../assets/home/av-4.jpg';

const catImg: Record<string, ImageMetadata> = {
  tiles: catTiles,
  kitchens: catKitchens,
  bathrooms: catBathrooms,
  wardrobes: catWardrobes,
};
const avatars = [av1, av2, av3, av4];
const features = [
  { src: feat1, alt: 'A finished open-plan living space with large-format flooring' },
  { src: feat2, alt: 'A handle-less kitchen run with run-to-ceiling cabinetry' },
  { src: feat3, alt: 'A calm bathroom with a wall-hung vanity and mirror' },
  { src: feat4, alt: 'A bright interior styled with restraint' },
];

// Showroom marquee + 3-step process.
const marquee = ['Tiles', 'Kitchens', 'Bathrooms', 'Wardrobes', '3D Rendering', 'Villeroy & Boch', 'Roca', 'Nitco'];
const steps = [
  {
    n: '01',
    title: 'Visit the showroom',
    body: 'See and feel the ranges in person. Our team learns your space, your style and your budget.',
  },
  {
    n: '02',
    title: 'See it in 3D',
    body: 'We render your kitchen or bathroom photo-realistically, so you decide with total confidence.',
  },
  {
    n: '03',
    title: 'Install with confidence',
    body: 'Sign off the design, we supply the products, and your space comes together — right the first time.',
  },
];

const live = offerIsVisible();
const started = offerHasStarted();
const statusLabel = offerStatusLabel();
---

<Base
  title="Premium Tiles, Kitchens, Bathrooms & Wardrobes in Nairobi"
  description={site.description}
  path="/"
>
  <!-- ============ HERO (editorial, image-in-headline) ============ -->
  <section class="hero">
    <div class="wrap">
      <p class="kicker hero__kicker">{site.legalName} · Nairobi</p>

      <h1 class="hero__title">
        <span class="hero__line">
          INSPIRED
          <span class="hero__inset hero__inset--wide">
            <Image src={heroA} alt="A finished kitchen in warm light" widths={[240, 480]} sizes="(max-width:600px) 28vw, 240px" />
          </span>
          LIVING,
        </span>
        <span class="hero__line">
          <span class="hero__inset hero__inset--sq">
            <Image src={heroB} alt="A spa-grade bathroom" widths={[160, 320]} sizes="(max-width:600px) 18vw, 160px" />
          </span>
          EVERY <span class="dim">DAY.</span>
        </span>
      </h1>

      <div class="hero__grid">
        <div class="hero__intro">
          <div class="avatars" aria-hidden="true">
            {avatars.map((a) => (
              <span class="avatars__item">
                <Image src={a} alt="" width={48} height={48} />
              </span>
            ))}
            <span class="avatars__label">Trusted by homeowners,<br />developers &amp; designers</span>
          </div>

          <p class="hero__lead">
            Premium tiles, kitchens, bathrooms and wardrobes — specified with
            restraint and brought to life with in-house 3D rendering, so you see
            your space before you build it.
          </p>

          <div class="hero__actions">
            {live ? (
              <a class="btn btn--offer" href="/offers">Shop the Home Upgrade Event</a>
            ) : (
              <a class="btn" href="/contact">Contact us now</a>
            )}
            <a class="btn btn--ghost" href="/products">Explore products</a>
          </div>
        </div>

        <div class="hero__carousel">
          <div class="carousel__head">
            <span class="carousel__caption">Recent work from the studio</span>
            <div class="carousel__nav">
              <button class="carousel__btn" type="button" data-dir="-1" aria-label="Previous image">
                <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg>
              </button>
              <button class="carousel__btn" type="button" data-dir="1" aria-label="Next image">
                <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg>
              </button>
            </div>
          </div>
          <ul class="carousel__track" id="hero-track">
            {features.map((f) => (
              <li class="carousel__slide">
                <Image src={f.src} alt={f.alt} widths={[480, 760, 1040]} sizes="(max-width:860px) 80vw, 540px" />
              </li>
            ))}
          </ul>
        </div>
      </div>

      {live && (
        <a class="offer-strip" href="/offers">
          <span class="offer-strip__tag">{started ? offer.kicker : 'Coming Soon'}</span>
          <span class="offer-strip__text">
            <strong>{offer.name}:</strong> {offer.headline}. {statusLabel || offerWindow()}.
          </span>
          <span class="offer-strip__cta">See the deals →</span>
        </a>
      )}
    </div>
  </section>

  <!-- ============ BRAND / OFFERING MARQUEE ============ -->
  <section class="marquee on-black" aria-hidden="true">
    <div class="marquee__track">
      {[...marquee, ...marquee, ...marquee].map((m) => (
        <span class="marquee__item">{m}<span class="marquee__dot">◆</span></span>
      ))}
    </div>
  </section>

  <!-- ============ STATEMENT (two-tone) ============ -->
  <section class="sec sec--white statement">
    <div class="wrap">
      <p class="kicker reveal">Inspired Living, Every Day</p>
      <h2 class="h-lg statement__h reveal">
        SURFACES, FITTINGS AND CABINETRY <span class="dim">CHOSEN WITH RESTRAINT</span> —
        SO YOUR SPACE FEELS OPEN, NOT BUSY.
      </h2>
    </div>
  </section>

  <!-- ============ PRODUCTS (overlay tiles) ============ -->
  <section class="sec sec--grey">
    <div class="wrap">
      <div class="head-row reveal">
        <div>
          <p class="kicker">What we do</p>
          <h2 class="h-md">Four categories, one standard.</h2>
        </div>
        <a class="btn btn--ghost head-row__cta" href="/products">All products</a>
      </div>

      <ul class="prodtiles">
        {categories.map((c, i) => (
          <li class="ptile reveal">
            <a class="ptile__link" href={`/products/${c.slug}`}>
              <Image
                class="ptile__img"
                src={catImg[c.slug]}
                alt={`${c.name} — ${c.tagline}`}
                widths={[400, 800]}
                sizes="(max-width:760px) 92vw, 600px"
              />
              <span class="ptile__num">{String(i + 1).padStart(2, '0')}</span>
              <div class="ptile__cap">
                <h3 class="ptile__name">{c.name}</h3>
                <p class="ptile__tag">{c.tagline}</p>
                <span class="ptile__more">Explore {c.name} <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="sec sec--white">
    <div class="wrap">
      <div class="head-row reveal">
        <div>
          <p class="kicker">How it works</p>
          <h2 class="h-md">From showroom to finished space.</h2>
        </div>
      </div>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step reveal">
            <span class="step__num">{s.n}</span>
            <h3 class="step__title">{s.title}</h3>
            <p class="step__body">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ 3D RENDERING SERVICE ============ -->
  <section class="sec sec--black on-black">
    <div class="wrap service">
      <div class="service__media">
        <Image src={service3d} alt="A 3D render of a planned bathroom in perspective" widths={[480, 760, 1040]} sizes="(max-width:860px) 90vw, 540px" />
      </div>
      <div class="service__copy reveal">
        <p class="kicker">The studio difference</p>
        <h2 class="h-lg service__h">
          SEE IT <span class="dim">BEFORE</span> YOU BUILD IT.
        </h2>
        <p class="service__lead">{service.blurb}</p>
        <a class="btn" href="/contact">Book a 3D consultation</a>
      </div>
    </div>
  </section>

  <!-- ============ GET IT RIGHT / THE TILING MISTAKE ============ -->
  <section class="sec sec--white">
    <div class="wrap">
      <div class="head-row reveal">
        <div>
          <p class="kicker">Why specification matters</p>
          <h2 class="h-md">Small choices, big difference.</h2>
        </div>
      </div>
      <div class="compare">
        <div class="compare__col reveal">
          <span class="compare__label compare__label--wrong">Wrong</span>
          <div class="tilegrid tilegrid--small" aria-hidden="true">
            {Array.from({ length: 42 }).map(() => <span></span>)}
          </div>
          <h3 class="compare__h">Too many small tiles</h3>
          <p class="compare__p">Busy grout lines crowd the eye. The room shrinks and feels chaotic.</p>
        </div>
        <div class="compare__col reveal">
          <span class="compare__label">Correct</span>
          <div class="tilegrid tilegrid--large" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </div>
          <h3 class="compare__h">Large format tiles</h3>
          <p class="compare__p">Fewer grout lines. The eye travels. The room feels open and spacious.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CLIENTELE ============ -->
  <section class="sec sec--grey">
    <div class="wrap">
      <div class="head-row reveal">
        <div>
          <p class="kicker">Who we work with</p>
          <h2 class="h-md">Built for every kind of project.</h2>
        </div>
      </div>
      <ul class="clients">
        {clientele.map((c, i) => (
          <li class="client reveal">
            <span class="client__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="client__h">{c.title}</h3>
            <p class="client__p">{c.blurb}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {live && (
    <!-- ============ OFFER BAND (OFFER-ONLY accent) ============ -->
    <section class="offer-band">
      <div class="wrap offer-band__inner">
        <div>
          <p class="offer-band__kicker">{statusLabel || offer.kicker} · {offerWindow()}</p>
          <h2 class="h-md offer-band__h">{offer.name}</h2>
          <p class="offer-band__sub">{offer.headline} — while stocks last.</p>
        </div>
        <a class="btn btn--offer" href="/offers">View the deals</a>
      </div>
    </section>
  )}

  <!-- ============ FINAL CTA ============ -->
  <section class="sec sec--black on-black cta-final">
    <div class="wrap cta-final__inner">
      <p class="kicker">Not sure what works for you?</p>
      <h2 class="h-xl cta-final__h">
        GET IT <span class="dim">RIGHT THE</span><br />FIRST TIME.
      </h2>
      <p class="cta-final__sub">Visit our showroom and let our experts guide you.</p>
      <p class="cta-final__addr">
        {site.address.line1}, {site.address.line2}, {site.address.city}
      </p>
      <div class="hero__actions">
        <a class="btn" href="/contact">Plan your visit</a>
        <a class="btn btn--ghost" href={`tel:${site.phones[0].replace(/\s+/g, '')}`}>
          {site.phones[0]}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
  }
  .hero__kicker {
    margin-bottom: clamp(1rem, 2vw, 1.6rem);
  }

  /* Editorial headline with images inset between words */
  .hero__title {
    font-size: clamp(2.4rem, 7.6vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .hero__line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.2em;
  }
  .hero__line + .hero__line {
    margin-top: 0.12em;
  }
  .hero__inset {
    display: inline-block;
    overflow: hidden;
    flex: none;
    align-self: center;
  }
  .hero__inset :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__inset--wide {
    width: clamp(6rem, 20vw, 13rem);
    height: clamp(2.6rem, 6.6vw, 4.8rem);
  }
  .hero__inset--sq {
    width: clamp(2.6rem, 6.6vw, 4.8rem);
    height: clamp(2.6rem, 6.6vw, 4.8rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .hero__lead {
    margin-top: 1.4rem;
    max-width: 42ch;
    font-size: clamp(0.98rem, 1.3vw, 1.1rem);
    color: var(--grey-700);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.8rem;
  }

  /* Avatar cluster (square, overlapping) */
  .avatars {
    display: flex;
    align-items: center;
  }
  .avatars__item {
    width: 48px;
    height: 48px;
    overflow: hidden;
    margin-left: -10px;
    border: 2px solid var(--white);
    flex: none;
  }
  .avatars__item:first-child {
    margin-left: 0;
  }
  .avatars__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .avatars__label {
    margin-left: 1rem;
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--grey-500);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  /* Carousel */
  .hero__carousel {
    min-width: 0;
  }
  .carousel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .carousel__caption {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    color: var(--grey-500);
  }
  .carousel__nav {
    display: flex;
    gap: 0.6rem;
  }
  .carousel__btn {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--white);
    border: 1.5px solid var(--black);
    color: var(--black);
    cursor: pointer;
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .carousel__btn:hover {
    background: var(--black);
    color: var(--white);
  }
  .carousel__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .carousel__track::-webkit-scrollbar {
    display: none;
  }
  .carousel__slide {
    flex: 0 0 88%;
    max-width: 540px;
    scroll-snap-align: start;
  }
  .carousel__slide :global(img) {
    width: 100%;
    height: clamp(16rem, 32vw, 26rem);
    object-fit: cover;
    display: block;
  }

  /* ---- Offer strip ---- */
  .offer-strip {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
    padding: 0.9rem 1.2rem;
    background: var(--black);
    color: var(--white);
  }
  .offer-strip__tag {
    flex: none;
    background: var(--yellow);
    color: var(--black);
    font-weight: 700;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.6rem;
  }
  .offer-strip__text {
    flex: 1;
    font-size: 0.92rem;
  }
  .offer-strip__cta {
    flex: none;
    font-weight: 600;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--yellow);
  }

  /* ---- Marquee ---- */
  .marquee {
    background: var(--black);
    color: var(--white);
    overflow: hidden;
    padding-block: 1.1rem;
    border-block: 1px solid var(--grey-900);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 38s linear infinite;
  }
  .marquee__item {
    display: inline-flex;
    align-items: center;
    font-weight: 700;
    font-size: clamp(1rem, 2vw, 1.5rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--grey-300);
  }
  .marquee__dot {
    margin-inline: clamp(1.2rem, 3vw, 2.4rem);
    font-size: 0.6em;
    color: var(--grey-600, var(--grey-500));
  }
  @keyframes marquee {
    to {
      transform: translateX(-33.333%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }

  /* ---- Statement ---- */
  .statement__h {
    margin-top: 1.2rem;
    max-width: 20ch;
  }

  /* ---- Section head row ---- */
  .head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .head-row .kicker {
    margin-bottom: 0.6rem;
  }

  /* ---- Product overlay tiles ---- */
  .prodtiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .ptile__link {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--black);
  }
  .ptile__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .ptile__link::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 10, 10, 0.85) 0%, rgba(10, 10, 10, 0.1) 55%, rgba(10, 10, 10, 0.05) 100%);
  }
  .ptile__link:hover .ptile__img {
    transform: scale(1.05);
  }
  .ptile__num {
    position: absolute;
    top: 1rem;
    right: 1.3rem;
    z-index: 1;
    font-weight: 800;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1;
    color: rgba(255, 255, 255, 0.22);
  }
  .ptile__cap {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 1;
    padding: clamp(1.2rem, 2.5vw, 1.8rem);
    color: var(--white);
  }
  .ptile__name {
    font-size: clamp(1.4rem, 2.6vw, 2rem);
  }
  .ptile__tag {
    margin-top: 0.3rem;
    color: var(--grey-300);
    font-size: 0.95rem;
  }
  .ptile__more {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.76rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--white);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .ptile__link:hover .ptile__more,
  .ptile__link:focus-visible .ptile__more {
    opacity: 1;
    transform: none;
  }

  /* ---- Steps ---- */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    counter-reset: step;
  }
  .step {
    padding-top: 1.6rem;
    border-top: 2px solid var(--black);
  }
  .step__num {
    font-weight: 800;
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    line-height: 1;
    color: var(--grey-300);
  }
  .step__title {
    margin-top: 1rem;
    font-size: 1.25rem;
  }
  .step__body {
    margin-top: 0.7rem;
    color: var(--grey-700);
    max-width: 34ch;
  }

  /* ---- Service ---- */
  .service {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .service__h {
    margin-top: 1rem;
  }
  .service__lead {
    margin-top: 1.4rem;
    margin-bottom: 2rem;
    color: var(--grey-300);
    max-width: 46ch;
  }
  .service__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  /* ---- Compare (tiling) ---- */
  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .compare__label {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--grey-500);
    margin-bottom: 1rem;
  }
  .tilegrid {
    display: grid;
    gap: 4px;
    aspect-ratio: 4 / 3;
    margin-bottom: 1.4rem;
  }
  .tilegrid--small {
    grid-template-columns: repeat(7, 1fr);
    background: var(--white);
  }
  .tilegrid--small span {
    background: var(--black);
  }
  .tilegrid--large {
    grid-template-columns: repeat(2, 1fr);
    background: var(--grey-300);
  }
  .tilegrid--large span {
    background: var(--grey-100);
  }
  .compare__h {
    font-size: 1.2rem;
  }
  .compare__p {
    margin-top: 0.6rem;
    color: var(--grey-700);
    max-width: 32ch;
  }

  /* ---- Clientele ---- */
  .clients {
    list-style: none;
    margin: 0;
    padding: 0;
