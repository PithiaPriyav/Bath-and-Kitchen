<script>
  // Hero carousel: scroll by one slide on prev/next.
  const track = document.getElementById('hero-track');
  if (track) {
    const step = () => {
      const slide = track.querySelector<HTMLElement>('.carousel__slide');
      return slide ? slide.offsetWidth + 16 : track.clientWidth;
    };
    document.querySelectorAll<HTMLButtonElement>('.carousel__btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.dataset.dir) || 1;
        track.scrollBy({ left: dir * step(), behavior: 'smooth' });
      });
    });
  }
</script>
