---
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import { categories, site, service, offer, offerIsVisible } from '../../data/site';

export function getStaticPaths() {
  return categories.map((c) => ({
    params: { slug: c.slug },
    props: { category: c },
  }));
}

const { category } = Astro.props;
const path = `/products/${category.slug}`;

// Related deals for this category, while the promo is upcoming or live.
const live = offerIsVisible();
const relatedDeals = live
  ? offer.deals.filter((d) => d.category.toLowerCase() === category.name.toLowerCase())
  : [];

// BreadcrumbList structured data.
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: site.url + '/products' },
    { '@type': 'ListItem', position: 3, name: category.name, item: site.url + path },
  ],
};
---

<Base
  title={`${category.name} — ${category.tagline}`}
  description={category.blurb}
  path={path}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} slot="head" />

  <section class="sec sec--white detail-head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <a href="/products">Products</a><span aria-hidden="true">/</span>
        <span aria-current="page">{category.name}</span>
      </nav>
      <p class="kicker">Category</p>
      <h1 class="h-xl detail-head__h">{category.name.toUpperCase()}.</h1>
      <p class="detail-head__lead">{category.blurb}</p>
    </div>
  </section>

  <section class="sec sec--grey">
    <div class="wrap detail-grid">
      <div class="detail-gallery">
        <Placeholder label={`${category.name} — main`} ratio="4 / 3" />
        <div class="detail-gallery__row">
          <Placeholder label="Detail" ratio="1 / 1" />
          <Placeholder label="Detail" ratio="1 / 1" />
          <Placeholder label="Detail" ratio="1 / 1" />
        </div>
      </div>

      <aside class="detail-aside reveal">
        <h2 class="detail-aside__h">{category.tagline}</h2>
        <ul class="detail-list">
          {category.highlights.map((h) => <li>{h}</li>)}
        </ul>
        <div class="detail-brands">
          <h3 class="detail-brands__h">Brands carried</h3>
          <ul>
            {category.brands.map((b) => <li>{b}</li>)}
          </ul>
        </div>
        <a class="btn" href="/contact">Enquire about {category.name}</a>
      </aside>
    </div>
  </section>

  {relatedDeals.length > 0 && (
    <section class="offer-band">
      <div class="wrap">
        <p class="offer-band__kicker">{offer.kicker}</p>
        <h2 class="h-md offer-band__h">{category.name} deals in {offer.name}</h2>
        <ul class="deal-mini">
          {relatedDeals.map((d) => (
            <li class="deal-mini__item">
              <span class="deal-mini__name">{d.name}</span>
              <span class="deal-mini__price">{d.note}</span>
            </li>
          ))}
        </ul>
        <a class="btn btn--offer" href="/offers">See all deals</a>
      </div>
    </section>
  )}

  <section class="sec sec--black on-black">
    <div class="wrap detail-cta reveal">
      <p class="kicker">Before you commit</p>
      <h2 class="h-lg">SEE YOUR {category.name.toUpperCase()} <span class="dim">IN 3D.</span></h2>
      <p class="detail-cta__p">{service.blurb}</p>
      <a class="btn" href="/contact">Book a consultation</a>
    </div>
  </section>
</Base>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--grey-500);
    margin-bottom: 2rem;
  }
  .crumbs a:hover {
    color: var(--black);
  }
  .crumbs [aria-current='page'] {
    color: var(--black);
    font-weight: 600;
  }
  .detail-head__h {
    margin-top: 1rem;
  }
  .detail-head__lead {
    margin-top: 1.4rem;
    max-width: 56ch;
    font-size: 1.1rem;
    color: var(--grey-700);
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  .detail-gallery__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1rem;
  }
  .detail-aside {
    background: var(--white);
    padding: clamp(1.5rem, 3vw, 2.2rem);
    border-top: 3px solid var(--black);
  }
  .detail-aside__h {
    font-size: 1.3rem;
    margin-bottom: 1.4rem;
  }
  .detail-list {
    list-style: none;
    margin: 0 0 1.8rem;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .detail-list li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.95rem;
  }
  .detail-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    background: var(--black);
  }
  .detail-brands {
    border-top: 1px solid var(--grey-200);
    padding-top: 1.4rem;
    margin-bottom: 1.8rem;
  }
  .detail-brands__h {
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    color: var(--grey-500);
    margin-bottom: 0.8rem;
  }
  .detail-brands ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.2rem;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .offer-band {
    background: var(--red);
    color: var(--white);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .offer-band__kicker {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--yellow);
  }
  .offer-band__h {
    margin-top: 0.6rem;
  }
  .deal-mini {
    list-style: none;
    margin: 1.6rem 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    max-width: 640px;
  }
  .deal-mini__item {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    font-size: 0.95rem;
  }
  .deal-mini__price {
    color: var(--yellow);
    font-size: 0.85rem;
    text-align: right;
  }
  .offer-band .btn--offer {
    background: var(--white);
    border-color: var(--white);
    color: var(--red);
  }
  .offer-band .btn--offer:hover {
    background: var(--yellow);
    border-color: var(--yellow);
    color: var(--black);
  }

  .detail-cta {
    max-width: 60ch;
  }
  .detail-cta__p {
    margin: 1.3rem 0 2rem;
    color: var(--grey-300);
  }

  @media (max-width: 820px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
